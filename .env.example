# This file IS loaded (from the cwd or repo root) by a tiny built-in reader;
# variables already set in the real environment always win.
#
# Anthropic credentials - without a key the pipeline runs in deterministic
# mode (code + heuristics); extraction of irregular text and line-level risk
# assessment use the model only when a key is present.
ANTHROPIC_API_KEY=

# LLM mode: auto (default: use the model iff credentials exist) | anthropic | stub
ORDERFLOW_LLM=auto

# Model for extraction/checks/judge (default: claude-opus-5)
ORDERFLOW_MODEL=claude-opus-5

# Business thresholds (defaults shown)
# ORDERFLOW_PRICE_REVIEW_TOL=2.0
# ORDERFLOW_PRICE_BLOCK_TOL=5.0
# ORDERFLOW_MIN_LEAD_DAYS=2

# Disable server-side refusal fallbacks on API calls (any value = off)
# ORDERFLOW_NO_FALLBACKS=1

# Paths
# ORDERFLOW_ERP_DB=erp.sqlite
# ORDERFLOW_RUNS_DIR=runs
# ORDERFLOW_DATA_DIR=data     # directory containing reference/ and samples/
